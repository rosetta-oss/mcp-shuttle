;; mcp-shuttle: MCP server and client for Clojure. Deliberately small deps: Clojure, data.json, and malli for
;; tool schemas (shuttle.tools).
;; No Ring adapter: the handler takes and returns Ring maps, and the streaming body shape is injected
;; (`:sse-writer`).
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        metosin/malli {:mvn/version "0.19.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clojure -M:lint   (CI fails on any warning)
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2025.10.23"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "warning"]}}}
